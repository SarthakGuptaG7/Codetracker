SERVER_PORT=8082
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Default local setup uses H2 and needs no database server.
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/codetracker;MODE=MySQL;DATABASE_TO_LOWER=TRUE;AUTO_SERVER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect

# To use MySQL instead, set these values:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/codetracker?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_password
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
